# Optional server-side GitHub authentication.
GITHUB_TOKEN=

# SQLite file; unset uses the OS cache directory.
SPOOR_CACHE_PATH=

# Exact browser origins, separated by commas. Set this in production.
SPOOR_ALLOWED_ORIGINS=

# HTTP DEEP costs more provider requests. Enriched FAST does not require it.
SPOOR_HTTP_DEEP_ENABLED=false

# Lookup creations per client and instance window, in seconds.
SPOOR_RATE_LIMIT_PER_IP=10
SPOOR_RATE_LIMIT_WINDOW_SECS=3600
SPOOR_GLOBAL_RATE_LIMIT=100
SPOOR_GLOBAL_RATE_LIMIT_WINDOW_SECS=3600

SPOOR_MAX_CONCURRENT_LOOKUPS=4

# Completed/failed record age from creation; pending/running records are retained.
SPOOR_LOOKUP_RETENTION_SECS=3600

# Uncached GitLeak requests per window. Cached responses have a 24-hour TTL.
SPOOR_GITLEAK_BUDGET=40
SPOOR_GITLEAK_BUDGET_WINDOW_SECS=3600

# Trusted ingress IPs/CIDRs only. Unset ignores X-Forwarded-For.
SPOOR_TRUSTED_PROXIES=
